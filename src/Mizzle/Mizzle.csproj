<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Mizzle</PackageId>
    <Description>Fluent SQL compiler core for Mizzle: immutable IR, builders, and dialect capability checks.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mizzle.Postgres" />
    <InternalsVisibleTo Include="Mizzle.SqlServer" />
  </ItemGroup>

</Project>
